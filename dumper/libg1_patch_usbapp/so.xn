PHDRS {
	text PT_LOAD ;
	data PT_LOAD ;
}
SECTIONS {
	.init  : { *(.init)  } :text
	.text  : { *(.text); *(.rodata); *(.rodata.*) } :text
	.fini  : { *(.fini)  } :text
	.fini  : { *(.fini)  } :text
	.dlsym : { *(.dlsym) } :text
	.dlstr : { *(.dlstr) } :text
	. = ALIGN(0x1000);
	.data  : { *(.data); *(.sdata)   } :data
	.sbss  : { *(.sbss); *(.scommon) } :data
	.bss   : { *(.bss);  *(COMMON)   } :data
	/DISCARD/ : { *(.reginfo); *(.MIPS.abiflags) }
}
ENTRY(_init)
