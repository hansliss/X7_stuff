set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR mips)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(X7_TOOLCHAIN_PREFIX "mips-linux-gnu" CACHE STRING "Cross compiler program prefix")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES X7_TOOLCHAIN_PREFIX)
find_program(X7_C_COMPILER NAMES "${X7_TOOLCHAIN_PREFIX}-gcc" REQUIRED)
set(CMAKE_C_COMPILER "${X7_C_COMPILER}")
set(CMAKE_ASM_COMPILER "${X7_C_COMPILER}")
set(CMAKE_C_FLAGS_INIT "-EL -mabi=32 -march=24kec")
set(CMAKE_ASM_FLAGS_INIT "-EL -mabi=32 -march=24kec")
